# The FastAPI backend. Server-side only -- never exposed to the browser.
BACKEND_API_URL=http://localhost:8000

# The site's own public origin, used as the metadataBase that relative
# Open Graph urls resolve against. Optional: on Vercel the production
# domain is used automatically, and `next dev` falls back to localhost.
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app
